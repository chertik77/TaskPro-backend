{
  "name": "taskpro-backend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/server.cjs",
    "build": "tsup src/server.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint --fix src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@better-auth/redis-storage": "^1.7.18",
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.18",
    "cloudinary": "^2.11.0",
    "hono": "^4.13.17",
    "ioredis": "^6.0.0",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
